# ============================================================
# AI材料申报与审核平台 — 环境变量模板
# 使用方法：复制此文件为 .env，至少更换下方标记为“必填”的本地密码/密钥
# cp .env.example .env
# ============================================================

# ============================================================
# 数据库连接
# ============================================================
DB_NAME=ai_competition_db
DB_USERNAME=aicompetition
# 必填：Compose 中应用数据库用户的密码
DB_PASSWORD=change_me_local_db_password
# 必填：仅用于管理本地 MySQL 容器，不会传给应用
MYSQL_ROOT_PASSWORD=change_me_local_root_password
# 宿主机暴露端口；容器间固定使用 3306
MYSQL_PORT=3306

# ============================================================
# JWT 认证
# ============================================================
# 必填：请改为至少 32 字节的随机字符串；不得提交真实值
JWT_SECRET=change_me_local_jwt_secret_at_least_32_bytes

# ============================================================
# DashScope AI 大模型（阿里云百炼平台）
# 获取方式：https://dashscope.console.aliyun.com/
# 可选：留空时项目仍可启动，AI 任务会返回明确的降级结果
# ============================================================
DASHSCOPE_API_KEY=

# ============================================================
# Redis（由 Compose 启动；业务层仍保留 Redis 故障降级能力）
# ============================================================
# 必填：本地 Redis 密码
REDIS_PASSWORD=change_me_local_redis_password
# 宿主机暴露端口；容器间固定使用 6379
REDIS_PUBLISHED_PORT=6379

# ============================================================
# 服务端口
# ============================================================
APP_PORT=8080
